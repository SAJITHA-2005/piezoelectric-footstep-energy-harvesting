/*
  Footstep tile dashboard (ESP32, Arduino-ESP32 core 2.x or 3.x)

  Serves a web page showing: storage-capacitor voltage, harvested energy (estimate),
  steps counted, energy per step, temperature and humidity (DHT22).

  Libraries to install (Library Manager): "DHT sensor library" (Adafruit) and
  "Adafruit Unified Sensor". WiFi and WebServer come with the ESP32 core.

  If STA_SSID is empty, the ESP32 makes its own Wi-Fi hotspot (no router needed).
  Join it with your phone, then open the address printed in the Serial Monitor
  (normally http://192.168.4.1).
*/
#include <WiFi.h>
#include <WebServer.h>
#include <DHT.h>

// ---------- settings to edit ----------
const char* STA_SSID = "";           // your home Wi-Fi name; leave "" for hotspot mode
const char* STA_PASS = "";
const char* AP_SSID  = "FootstepTile";
const char* AP_PASS  = "tile12345";  // at least 8 characters

const float C_STORE_F = 0.10f;       // storage capacitor in farads (check your part)
const float DIV_RATIO = 2.0f;        // (R1+R2)/R2 of the voltage divider on PIN_VSENSE
const float DV_MIN    = 0.02f;       // ignore voltage rises smaller than this (ADC noise)

// ---------- pins ----------
#define PIN_VSENSE 34   // ADC input from divider midpoint
#define PIN_VEN    25   // gate of a 2N7002 that grounds the divider only while measuring
#define PIN_STEP   35   // step pulse input (through a divider + clamp, never raw piezo volts)
#define PIN_DHT     4

DHT dht(PIN_DHT, DHT22);
WebServer server(80);

volatile uint32_t steps = 0;
volatile uint32_t lastStepMs = 0;
float vCap = 0, lastV = 0, energy_mJ = 0;
float temp = NAN, hum = NAN;
uint32_t lastSample = 0, lastDht = 0;

void IRAM_ATTR onStep() {
  uint32_t now = millis();
  if (now - lastStepMs > 300) {   // one footstep rings several pulses; count it once
    steps++;
    lastStepMs = now;
  }
}

// Divider is connected only for the few ms of a reading, so it does not leak harvested energy.
float readCapVoltage() {
  digitalWrite(PIN_VEN, HIGH);
  delay(30);                      // let the divider and filter capacitor settle
  uint32_t sum = 0;
  for (int i = 0; i < 8; i++) {
    sum += analogReadMilliVolts(PIN_VSENSE);
    delayMicroseconds(200);
  }
  digitalWrite(PIN_VEN, LOW);
  return (sum / 8.0f) / 1000.0f * DIV_RATIO;
}

const char PAGE[] PROGMEM = R"HTML(<!doctype html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><title>Footstep Tile</title>
<style>
body{font-family:system-ui,sans-serif;margin:0;padding:16px;background:#f4f6f8;color:#14202b}
h1{font-size:20px;margin:0 0 12px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.card{background:#fff;border-radius:10px;padding:12px;box-shadow:0 1px 3px rgba(0,0,0,.12)}
.card span{font-size:12px;color:#5b6b79}
.card b{display:block;font-size:24px;margin-top:4px}
