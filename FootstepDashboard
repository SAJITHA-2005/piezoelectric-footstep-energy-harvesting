</style></head><body>
<h1>Footstep Tile</h1>
<div class="grid">
<div class="card"><span>Harvested energy (estimate)</span><b id="e">-</b></div>
<div class="card"><span>Capacitor voltage</span><b id="v">-</b></div>
<div class="card"><span>Steps counted</span><b id="s">-</b></div>
<div class="card"><span>Energy per step</span><b id="eps">-</b></div>
<div class="card"><span>Temperature</span><b id="t">-</b></div>
<div class="card"><span>Humidity</span><b id="h">-</b></div>
</div>
<canvas id="c" width="600" height="160"></canvas>
<script>
const hist=[];
function $(i){return document.getElementById(i);}
function draw(){
  const c=$('c'),x=c.getContext('2d');
  x.clearRect(0,0,c.width,c.height);
  if(hist.length<2)return;
  const mx=Math.max(...hist,0.1),mn=Math.min(...hist),lo=Math.min(mn,mx-0.1);
  x.beginPath();
  hist.forEach((v,i)=>{
    const px=i*(c.width/119),py=c.height-10-(v-lo)/(mx-lo)*(c.height-34);
    if(i){x.lineTo(px,py);}else{x.moveTo(px,py);}
  });
  x.strokeStyle='#0f766e';x.lineWidth=2;x.stroke();
  x.fillStyle='#5b6b79';x.font='12px sans-serif';
