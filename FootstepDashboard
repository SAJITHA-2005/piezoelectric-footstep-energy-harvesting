}
async function tick(){
  try{
    const d=await (await fetch('/data')).json();
    $('e').textContent=d.e.toFixed(2)+' mJ';
    $('v').textContent=d.v.toFixed(2)+' V';
    $('s').textContent=d.s;
    $('eps').textContent=d.s>0?(d.e/d.s).toFixed(3)+' mJ':'-';
    $('t').textContent=d.t===null?'-':d.t.toFixed(1)+' \u00b0C';
    $('h').textContent=d.h===null?'-':d.h.toFixed(0)+' %';
    hist.push(d.v);if(hist.length>120)hist.shift();
    draw();
  }catch(e){}
}
setInterval(tick,2000);tick();
</script></body></html>)HTML";

void handleRoot() {
  server.send_P(200, "text/html", PAGE);
}

void handleData() {
  char t[16], h[16], buf[160];
  if (isnan(temp)) strcpy(t, "null"); else snprintf(t, sizeof t, "%.1f", temp);
  if (isnan(hum))  strcpy(h, "null"); else snprintf(h, sizeof h, "%.1f", hum);
  snprintf(buf, sizeof buf, "{\"v\":%.3f,\"e\":%.3f,\"s\":%lu,\"t\":%s,\"h\":%s}",
           vCap, energy_mJ, (unsigned long)steps, t, h);
  server.send(200, "application/json", buf);
}

void startWifi() {
  if (strlen(STA_SSID) > 0) {
    WiFi.mode(WIFI_STA);
    WiFi.begin(STA_SSID, STA_PASS);
    for (int i = 0; i < 30 && WiFi.status() != WL_CONNECTED; i++) delay(500);
    if (WiFi.status() == WL_CONNECTED) {
      Serial.print("Open http://");
      Serial.println(WiFi.localIP());
      return;
    }
  }
  WiFi.mode(WIFI_AP);
  WiFi.softAP(AP_SSID, AP_PASS);
  Serial.print("Hotspot ");
  Serial.print(AP_SSID);
  Serial.print(" -> http://");
  Serial.println(WiFi.softAPIP());
}

void setup() {
  Serial.begin(115200);
  pinMode(PIN_VEN, OUTPUT);
  digitalWrite(PIN_VEN, LOW);
  analogSetPinAttenuation(PIN_VSENSE, ADC_11db);
  pinMode(PIN_STEP, INPUT);
  attachInterrupt(digitalPinToInterrupt(PIN_STEP), onStep, RISING);
  dht.begin();
  vCap = readCapVoltage();
  lastV = vCap;
  startWifi();
  server.on("/", handleRoot);
  server.on("/data", handleData);
  server.begin();
}

void loop() {
  server.handleClient();
  uint32_t now = millis();

  if (now - lastSample >= 250) {
    lastSample = now;
    vCap = readCapVoltage();
    if (vCap >= lastV + DV_MIN) {
      // energy added to the capacitor: 1/2 * C * (V2^2 - V1^2), in millijoules
      energy_mJ += 0.5f * C_STORE_F * (vCap * vCap - lastV * lastV) * 1000.0f;
      lastV = vCap;
    } else if (vCap < lastV) {
      lastV = vCap;               // follow voltage down (LED flash, leakage)
    }
  }

  if (now - lastDht >= 5000) {
    lastDht = now;
    float t = dht.readTemperature();
    float h = dht.readHumidity();
    if (!isnan(t)) temp = t;
    if (!isnan(h)) hum = h;
  }
}
